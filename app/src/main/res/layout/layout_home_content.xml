<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Character Area - Anchored independently -->
    <ImageView
        android:id="@+id/characterImage"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitEnd"
        android:src="@drawable/guardian_character"
        android:translationX="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Stable Info Column - No longer dependent on dialogue height -->
    <View
        android:id="@+id/characterTouchTarget"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@id/characterImage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.21" />

    <LinearLayout
        android:id="@+id/leftInfoColumn"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.55">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panelTasks"
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#660F172A"
            app:strokeColor="@color/cyber_pink">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_tech_task"
                        app:tint="@color/cyber_pink" />

                    <TextView
                        style="@style/CyberTypography.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text=":: NEXT_TASK"
                        android:textColor="@color/cyber_pink"
                        android:textSize="8sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/topMissionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:text="..."
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panelSchedule"
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#660F172A"
            app:strokeColor="@color/cyber_cyan">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_tech_schedule"
                        app:tint="@color/cyber_cyan" />

                    <TextView
                        style="@style/CyberTypography.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text=":: NEXT_SCHEDULE"
                        android:textColor="@color/cyber_cyan"
                        android:textSize="8sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nextQuestText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:text="..."
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/panelAlarm"
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#660F172A"
            app:strokeColor="@color/cyber_lime">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_tech_alarm"
                        app:tint="@color/cyber_lime" />

                    <TextView
                        style="@style/CyberTypography.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text=":: NEXT_ALARM"
                        android:textColor="@color/cyber_lime"
                        android:textSize="8sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nextSummonText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="..."
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/charGrowthLayout"
            style="@style/CyberCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#660F172A"
            app:strokeColor="@color/cyber_cyan">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/CyberTypography.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":: CURA_LEVEL"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/charLevelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lv. 1"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/charExpProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:progress="35"
                    android:progressDrawable="@drawable/progress_exp_tech" />

                <TextView
                    android:id="@+id/charExpText"
                    style="@style/CyberTypography.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="35/100"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Dialogue Bubble - Top Left Area, stable position and FIXED size -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dialogueBubble"
        android:layout_width="180dp"
        android:layout_height="140dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:alpha="0.0"
        app:cardBackgroundColor="#CC0F172A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/cyber_cyan"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                style="@style/CyberTypography.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":: CURA"
                android:textColor="@color/cyber_cyan"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/dialogueText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="5"
                android:text="..."
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Feedback Layer -->
    <TextView
        android:id="@+id/expFeedbackText"
        style="@style/CyberTypography.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+10 EXP"
        android:textColor="@color/cyber_lime"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/leftInfoColumn"
        app:layout_constraintStart_toStartOf="@id/leftInfoColumn" />

</androidx.constraintlayout.widget.ConstraintLayout>
