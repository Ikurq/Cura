<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ModernCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:strokeColor="@color/cyber_cyan">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:minWidth="64dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/scheduleTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:fontFamily="sans-serif-condensed-medium" />

                <TextView
                    android:id="@+id/scheduleEndTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="〜09:30"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="4dp"
                android:layout_height="40dp"
                android:background="@color/outline"
                android:layout_marginHorizontal="12dp"
                android:backgroundTint="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/scheduleTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="タイトル"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/scheduleTypeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="詳細情報"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Attendance Tracking Bar -->
        <LinearLayout
            android:id="@+id/attendanceActionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/attendanceStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="出欠ステータス"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_gravity="center_vertical" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
