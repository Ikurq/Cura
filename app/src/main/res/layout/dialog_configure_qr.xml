<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/qr_preview_title"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <ImageView
        android:id="@+id/imgQrPreview"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@color/white"
        android:padding="8dp"
        android:contentDescription="@string/qr_preview_title"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/textCurrentQrValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CURA_DISMISS_ALARM"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="このQRコードを印刷するか、別端末で表示して解除に使用できます。また、下記より任意のバーコード/文字列を登録することも可能です。"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnChangeQrText"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="解除コードの文字列を変更"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnResetQr"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_reset_default_qr" />

</LinearLayout>
