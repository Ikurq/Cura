<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogTaskHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="新しいタスクを追加"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <!-- 1. タスクの内容 -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="タスクの内容"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/dialogTaskTitleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. 目標デッドライン (詳細設定ON時のみ表示) -->
    <LinearLayout
        android:id="@+id/dialogTargetDeadlineContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目標期限"
            android:textSize="12sp"
            android:textColor="@color/cyber_cyan"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/dialogTaskTargetDeadlineButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="未設定 (タップして設定)" />

            <ImageButton
                android:id="@+id/dialogTaskClearTargetDeadlineButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="目標期限を解除"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. メインデッドライン (通常は「期限」、詳細設定時は「本当のデッドライン (最終期限)」) -->
    <TextView
        android:id="@+id/dialogRealDeadlineLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="期限"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/dialogTaskDeadlineButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="日付を選択してください"
        android:layout_marginBottom="10dp" />

    <!-- 4. 詳細設定チェックボックス -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/dialogTaskAdvancedDeadlineCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="目標期限も設定する"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="14dp" />

    <!-- 5. 基本優先度 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="基本優先度 (1〜5)"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/dialogTaskPrioritySpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <!-- 6. カレンダー予定連携 -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/dialogTaskAddToScheduleCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/task_add_to_schedule"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="12dp" />

</LinearLayout>
